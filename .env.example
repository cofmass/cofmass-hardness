# 阶段一：PostgreSQL + pgvector（Docker 容器 hardness-pg）
# 复制本文件为 .env 后按需修改；.env 不入库，含真实密码。
# 需要 PostgreSQL + pgvector；容器示例：
#   docker run -d --name hardness-pg \
#     -e POSTGRES_DB=hardness -e POSTGRES_USER=hardness -e POSTGRES_PASSWORD=<密码> \
#     -p 5432:5432 pgvector/pgvector:pg16

# 留空则降级到 SQLite 脚手架（不计入阶段一交付）
HARDNESS_PG_DSN=postgresql://hardness:<密码>@127.0.0.1:5432/hardness

# ---- 可选覆盖项 ----
# HARDNESS_CHAT_MODEL=deepseek-r1:7b
# HARDNESS_EMB_MODEL=nomic-embed-text
# HARDNESS_EMB_DIM=768
# HARDNESS_RAG_TOP_K=3
# OLLAMA_BASE_URL=http://127.0.0.1:11434
